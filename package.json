{
	"name": "songs-of-doom",
	"private": true,
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"dev": "npm run dev -w @songsofdoom/web",
		"build": "npm run build --workspaces",
		"preview": "npm run preview -w @songsofdoom/web",
		"test": "npm run test --workspaces --if-present",
		"check": "npm run check --workspaces",
		"lint": "npm run lint -w @songsofdoom/web",
		"format": "prettier --write .",
		"prepare": "husky"
	},
	"devDependencies": {
		"husky": "^9.1.7",
		"lint-staged": "^16.2.7",
		"prettier": "^3.7.4"
	},
	"lint-staged": {
		"*.{ts,js,svelte,json,css,scss,md,html}": "prettier --check",
		"*.{ts,js,svelte}": "npx eslint --config packages/web/eslint.config.js"
	}
}
