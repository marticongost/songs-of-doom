{
	"name": "@songsofdoom/web",
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "npm-run-all -p watch:svg dev:svelte",
		"dev:svelte": "vite dev",
		"build": "vite build",
		"prebuild": "svgo -f src/lib/assets/svg",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"watch:svg": "chokidar 'src/lib/assets/svg/**/*.svg' -c 'node scripts/optimize-svg.mjs {path}'",
		"seed:characters": "vite-node --options.transformMode.ssr='/.*/' scripts/seed-characters.ts",
		"generate-images": "vite-node --options.transformMode.ssr='/.*/' scripts/generate-images.ts"
	},
	"dependencies": {
		"@emotion/css": "^11.13.5",
		"@emotion/server": "^11.11.0",
		"@node-rs/argon2": "^2.0.2",
		"@prisma/adapter-pg": "^7.4.0",
		"@prisma/client": "^7.4.0",
		"@songsofdoom/common": "*",
		"@songsofdoom/game": "*",
		"dotenv": "^17.2.4",
		"fast-glob": "^3.3.3",
		"js-yaml": "^4.1.1",
		"pg": "^8.18.0"
	},
	"devDependencies": {
		"@anthropic-ai/sdk": "^0.78.0",
		"@eslint/compat": "^1.4.0",
		"@eslint/js": "^9.39.1",
		"@google/genai": "^1.49.0",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/kit": "^2.61.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^24",
		"@types/pg": "^8.16.0",
		"chokidar-cli": "^3.0.0",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.13.1",
		"globals": "^16.5.0",
		"jsdom": "^28.0.0",
		"mdsvex": "^0.12.6",
		"npm-run-all": "^4.1.5",
		"prettier": "^3.7.4",
		"prettier-plugin-svelte": "^3.4.0",
		"prisma": "^7.4.0",
		"svelte": "^5.56.0",
		"svelte-check": "^4.3.4",
		"svgo": "^4.0.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.48.1",
		"vite": "^7.2.6",
		"vite-node": "^5.3.0",
		"vitest": "^4.0.15"
	}
}
