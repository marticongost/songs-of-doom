generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String            @id
  createdAt       DateTime          @default(now())
  username        String            @unique
  password        String
  sessions        Session[]
  characters      Character[]
  gameParticipant GameParticipant[]
  ownedGames      Game[]
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(references: [id], fields: [userId], onDelete: Cascade)

  @@index([userId])
}

model Character {
  id              Int                 @id @default(autoincrement())
  ownerId         String
  owner           User                @relation(references: [id], fields: [ownerId], onDelete: Cascade)
  revisions       CharacterRevision[]
  gameParticipant GameParticipant[]
}

model CharacterRevision {
  characterId Int
  character   Character @relation(references: [id], fields: [characterId], onDelete: Cascade)
  number      Int
  createdAt   DateTime  @default(now())
  state       Json
  totalXp     Int
  finalised   Boolean

  @@id([characterId, number])
}

enum GameStatus {
  PREPARATION
  ACTIVE
  COMPLETE
  ABANDONED
}

model Game {
  id         String     @id @default(uuid())
  status     GameStatus @default(PREPARATION)
  campaignId String?
  ownerId    String?
  owner      User?      @relation(references: [id], fields: [ownerId], onDelete: SetNull)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  participants GameParticipant[]
  journal      JournalEntry[]
}

model GameParticipant {
  gameId                       String
  userId                       String
  characterId                  Int
  lastAcknowledgedJournalIndex Int    @default(-1)

  game      Game      @relation(references: [id], fields: [gameId], onDelete: Cascade)
  user      User      @relation(references: [id], fields: [userId], onDelete: Cascade)
  character Character @relation(references: [id], fields: [characterId], onDelete: Cascade)

  @@id([gameId, userId])
  @@unique([gameId, characterId])
  @@index([userId])
}

model JournalEntry {
  gameId    String
  index     Int
  data      Json
  gamestate Json?
  game      Game   @relation(references: [id], fields: [gameId], onDelete: Cascade)

  @@id([gameId, index])
  @@index([gameId])
}
